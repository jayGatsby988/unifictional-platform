# --- Core server configuration ---
OPENAI_API_KEY=            # server only: Jarvis (gpt-6-astra), vision analysis, and OpenAI photoreal renders
BLOB_READ_WRITE_TOKEN=     # Vercel Blob — photo uploads, render storage, shared projects (auto-set on Vercel)

# --- Required for hosted scan photo finish analysis ---
# Server-only Upstash Redis REST credentials; never use NEXT_PUBLIC_ for these.
# Hosted/production /api/native/finishes returns 503 without durable admission.
# See docs/scan-finish-admission.md. No Redis service is provisioned by this repo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Keep this stable across instances/redeploys to share one global budget.
SCAN_FINISH_ADMISSION_NAMESPACE=manhattan-scan-finishes-v1

# --- Model overrides ---
OPENAI_VISION_MODEL=gpt-5.4   # fastest valid structured-output model in our tests (13s); gpt-5.6-terra ≈ 23s
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high   # low | medium | high — high costs ~3x medium and takes ~60-90s, but matches the 3D design far more closely
RENDER_PROVIDER=openai     # openai | google | higgsfield  (primary photoreal render provider; others used as fallback if keys present)

# --- Optional providers ---
GOOGLE_API_KEY=            # Gemini API (billing-enabled project) — Nano Banana renders (best structure preservation)
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image   # Nano Banana 2 (~$0.07/img, ~20s). Use gemini-3-pro-image for Nano Banana Pro (~$0.13/img)
HIGGSFIELD_API_KEY=        # Higgsfield Cloud API (cloud.higgsfield.ai) key id — official API exposes /nano-banana edits; no 3D endpoints
HIGGSFIELD_API_SECRET=     # key secret (sent as 'Authorization: Key id:secret')
HIGGSFIELD_EDIT_PATH=/nano-banana   # try /nano-banana-pro once your account has it enabled
MESHY_API_KEY=             # Meshy image-to-3D "AI scan" tier
ANTHROPIC_API_KEY=         # optional alternate vision analyzer
INVENTORY_HEAD_START_MS=60000  # Wait up to60s for photo inventory labels/counts to inform reconstruction;0 explicitly favors parallel speed. Shared270s analysis deadline still applies.

NEXT_PUBLIC_APP_URL=http://localhost:3000
