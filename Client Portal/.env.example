# ---- Portal (leave the Supabase keys empty to run in demo mode) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PORTAL_DEMO=true

# ---- Sync job (server only) ----
# Supabase → Project Settings → API → service_role (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel Cron sends it as "Authorization: Bearer …"; also signs OAuth state.
CRON_SECRET=

# Google Cloud OAuth client (type: Web application). One Cloud project with these APIs enabled:
# Google Analytics Admin API, Google Analytics Data API, Google Search Console API,
# PageSpeed Insights API, My Business Account Management API, My Business Business
# Information API, Business Profile Performance API.
# Authorized redirect URI:  https://<portal-domain>/api/integrations/google/callback
# Then press "Connect Google" on /admin with the Unifictional Google account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# PageSpeed Insights API key (same project → Credentials → API key). Optional but avoids rate limits.
PSI_API_KEY=
# Optional fallback for Analytics + Search Console only: a service-account JSON (raw or base64)
# that you add to each client's property by hand. Not needed when the studio Google account is connected.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta app (Facebook Login for Business) with pages_show_list, pages_read_engagement,
# read_insights, instagram_basic, instagram_manage_insights, business_management.
# Valid OAuth redirect URI:  https://<portal-domain>/api/integrations/meta/callback
# Then press "Connect Meta" on /admin with the Facebook account that administers the clients' Pages.
META_APP_ID=
META_APP_SECRET=

# ---- Lead capture (landing page free inspection + create account) ----
# Same GoHighLevel sub-account as the main site; leads are tagged brand-unifictional.
GHL_TOKEN=
GHL_LOCATION_ID=

# ---- Live Google rankings in the free inspection ----
# Google Programmable Search: create a search engine at programmablesearchengine.google.com
# (search the entire web), copy its ID into GOOGLE_CSE_CX, and enable "Custom Search API" on the
# same Cloud project as the PageSpeed key. 100 queries/day free, then $5 per 1,000. Each inspection
# uses 5 queries. Brave Search (api.search.brave.com, free tier) is the fallback provider.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=

# Billing (Square). Server-only. SQUARE_ENVIRONMENT=sandbox to test; SQUARE_LOCATION_ID only if you have several locations.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=
SQUARE_LOCATION_ID=

# ---- SEO Autopilot (server only) ----
# Writes each client's blog post. platform.claude.com → API keys. One post ≈ one Claude Opus 5.5 call.
ANTHROPIC_API_KEY=
# Lets the daily run commit posts to the GitHub repos of sites we host (fine-grained token,
# Contents: read and write on the client site repos). Set each company's repo on /admin.
# WordPress clients give their own application password on their SEO Autopilot page instead.
GITHUB_TOKEN=
# Sites we host that aren't deployed from GitHub render their blog from
# /api/autopilot/feed?client=<slug> and expose /api/revalidate?secret=…; put that URL on the
# company's Data connections (Revalidate URL) and the bot pings it after each publish.
