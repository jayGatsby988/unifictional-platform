# ──────────────────────────────────────────────────────────────────────────
#  Unifictional booking system — copy this file to `.env.local` and fill in.
#  The site runs without any of these (fully testable locally), but real
#  calendar checks + emails only happen once the relevant keys are set.
#  See BOOKING_SETUP.md for the step-by-step.
# ──────────────────────────────────────────────────────────────────────────

# ── Where & when you take calls ───────────────────────────────────────────
# IANA timezone the hours below are expressed in.
BOOKING_TIMEZONE=America/New_York
# Bookable window in 24h local time. 7 = 7:00 AM, 23 = 11:00 PM.
BOOKING_HOURS_START=7
BOOKING_HOURS_END=23
# Meeting length + how far apart slots are offered (minutes).
BOOKING_DURATION_MIN=30
BOOKING_SLOT_STEP_MIN=30
# Padding kept around existing events (minutes).
BOOKING_BUFFER_MIN=0
# Minimum notice before a slot can be booked (minutes). 720 = 12 hours.
BOOKING_LEAD_MIN=720
# How far ahead people can book (days).
BOOKING_MAX_DAYS=60
# Shown on the invite + emails.
BOOKING_LOCATION=Phone call — we'll call you at the number you provide

# ── Identity ──────────────────────────────────────────────────────────────
OWNER_NAME=Unifictional
OWNER_EMAIL=Unifictional@gmail.com
BRAND_NAME=Unifictional
# Public site URL (used in email links). Set to your real domain in prod.
NEXT_PUBLIC_SITE_URL=https://unifictional.com

# ── Google Calendar (service account) ─────────────────────────────────────
# Create a service account in Google Cloud, enable the Calendar API, then
# SHARE Unifictional@gmail.com's calendar with the service-account email
# ("Make changes to events"). Calendar to read/write:
GOOGLE_CALENDAR_ID=Unifictional@gmail.com
# Option A — two vars (note: keep the literal \n in the key, it's normalized):
GOOGLE_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Option B — paste the whole downloaded JSON on one line instead of A:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Personal Gmail (not Workspace): leave this OFF — a service account can't
# invite attendees without Workspace domain-wide delegation. The booking still
# lands on your calendar and the client gets their invite via the email .ics.
# GOOGLE_INVITE_ATTENDEES=false

# ── Email — Option 1: Gmail (send FROM Unifictional@gmail.com) ─────────────
# Turn on 2-Step Verification for the account, then create an "App Password"
# (Google Account → Security → 2-Step Verification → App passwords). Paste the
# 16-char password here (spaces are fine — they're stripped). Preferred path.
GMAIL_USER=Unifictional@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Email — Option 2: Resend (alternative; only used if GMAIL_* is unset) ──
# Get a key at resend.com + verify a domain you own. You can't verify
# gmail.com, so this sends from your domain (e.g. hello@unifictional.com).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Unifictional <hello@unifictional.com>

# ── Secrets ───────────────────────────────────────────────────────────────
# Long random string — signs the email-verification tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_SECRET=change-me-to-a-long-random-string
# Protects the daily reminder cron endpoint. Vercel Cron sends it automatically
# as a Bearer token when this env var is set.
CRON_SECRET=change-me-to-another-long-random-string
